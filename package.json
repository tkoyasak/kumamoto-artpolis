{
  "name": "kumamoto-artpolis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf node_modules/.astro .astro dist",
    "deploy": "astro build && wrangler deploy --strict",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/preact": "5.1.5",
    "@nanostores/preact": "1.1.0",
    "@preact/compat": "18.3.2",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "26.0.0",
    "astro": "6.4.8",
    "maplibre-gl": "5.24.0",
    "nanostores": "1.3.0",
    "preact": "10.29.2",
    "tailwindcss": "4.3.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vite-plus": "0.2.1",
    "vitest": "4.1.9",
    "wrangler": "4.103.0"
  },
  "devDependencies": {
    "bun-types": "1.3.14"
  },
  "overrides": {
    "react": "$@preact/compat",
    "react-dom": "$@preact/compat",
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "warn"
    }
  }
}

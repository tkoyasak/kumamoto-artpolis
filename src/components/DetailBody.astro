---
// A detail page's rendered Markdown body. `relative` stacks the text above
// the persisted fixed map layer; pointer-events-none + auto children let
// clicks in the gaps reach the map square behind, while the text stays
// selectable.
---

<main class="pointer-events-none relative max-w-2xl px-4 py-4 pl-8 text-sm sm:px-8 sm:pl-12">
  <div class="pointer-events-auto">
    <slot />
  </div>
</main>

---
import type { DetailRow } from "../lib/table.ts";
import { DetailTableView } from "./TableView.tsx";

// The static tables' host: the detail pages and the entry pages' visit
// lists. The markup is the shared TableView, rendered with no client
// directive — static HTML, zero JS. Rows carry `data-row-*` hooks bound by
// the script below: the clicked row tags itself with its
// view-transition-name and navigates; the return is paired in
// `astro:before-swap` from the incoming document. The islands
// (SortableTable.tsx) tag their rows with the same hooks, so this one script
// drives every table's morphs.
interface Props {
  headers: string[];
  rows: DetailRow[];
  colWidths: readonly string[];
  headVt: string;
  // Tailwind max-width class for the wrapper.
  maxWidth: string;
  // The row is the page's own subject (the single row on a detail page): it
  // always shows its outline, carries its transition name up front, and
  // clicking it navigates back to `backHref`. Off, rows render list-style and
  // click through to their own pages.
  subject?: boolean;
  backHref: string;
}

const { headers, rows, colWidths, headVt, maxWidth, subject = false, backHref } = Astro.props;
---

<DetailTableView
  headers={headers}
  rows={rows}
  colWidths={colWidths}
  headVt={headVt}
  maxWidth={maxWidth}
  subject={subject}
  backHref={backHref}
/>

<script>
  // Rebind on each swap since rows are fresh DOM; a dataset flag guards
  // against double-binding.
  import { navigate } from "astro:transitions/client";

  import { normalizePath } from "../lib/routes.ts";
  import { navigateWithRowMorph } from "../lib/row-morph.ts";
  import { $hovered, isRowHighlighted } from "../lib/stores.ts";
  import { rowTransitionName } from "../lib/transitions.ts";

  // Non-subject rows share the map island's hover highlight, exactly like the
  // island tables' rows: a row hover lights its own row and rings its marker,
  // and hovering the marker lights every row keyed to it (isRowHighlighted).
  // The marker key defaults to the row's own href, so a plain entry row (the
  // visited entry on /status/<id>) links to its own marker with no extra
  // wiring. Subject rows are the page itself — always outlined, never linked.
  function markerLinkedRows() {
    return document.querySelectorAll<HTMLElement>("[data-row-nav]:not([data-row-subject])");
  }
  const markerOf = (row: HTMLElement) => row.dataset.markerHref ?? row.dataset.rowHref!;

  // Static rows can't re-render, so mirror the island's reactive outline by
  // toggling the class from $hovered.
  function applyRowHighlight() {
    const hovered = $hovered.get();
    for (const row of markerLinkedRows()) {
      row.classList.toggle("outline", isRowHighlighted(hovered, row.dataset.rowHref!, markerOf(row)));
    }
  }

  function bindRows() {
    for (const row of document.querySelectorAll<HTMLElement>("[data-row-nav]")) {
      if (row.dataset.bound) continue;
      row.dataset.bound = "1";
      if (!row.hasAttribute("data-row-subject")) {
        const rowHref = row.dataset.rowHref!;
        const markerHref = markerOf(row);
        row.addEventListener("mouseenter", () => $hovered.set({ marker: markerHref, row: rowHref }));
        row.addEventListener("mouseleave", () => $hovered.set(null));
      }
      row.addEventListener("click", (event) => {
        // Let the browser handle modified clicks on the name link (new tab, etc.).
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        // Cancel the name link's full-page navigation; the ClientRouter keeps
        // the persisted map alive.
        event.preventDefault();
        if (row.hasAttribute("data-row-subject")) {
          navigate(row.dataset.rowBack!);
        } else {
          navigateWithRowMorph(row.dataset.rowHref!);
        }
      });
    }
  }

  function refresh() {
    bindRows();
    // Rows are fresh DOM after a swap; re-seed their highlight from the
    // current hover ($hovered may not have changed, so its subscription alone
    // wouldn't fire).
    applyRowHighlight();
  }

  refresh();
  document.addEventListener("astro:page-load", refresh);
  // Runs once (the module is deduped across navigations, like the map script).
  $hovered.subscribe(applyRowHighlight);

  // Returning to a list/home page: pair the incoming row matching the page
  // we're leaving (same transition name) so the subject row morphs back into
  // its slot; clean up the injected name once the animation finishes.
  document.addEventListener("astro:before-swap", (event) => {
    const from = normalizePath(event.from.pathname);
    const row = event.newDocument.querySelector<HTMLElement>(`[data-row-href="${from}"]`);
    if (!row) return;
    row.style.setProperty("view-transition-name", rowTransitionName(from));

    const vt = event.viewTransition;
    if (!vt) return;
    const liveRow = () => document.querySelector<HTMLElement>(`[data-row-href="${from}"]`);
    // data-row-flourish is set only by the islands' rows (SortableTable.tsx).
    if (row.hasAttribute("data-row-flourish")) {
      row.classList.add("outline");
      vt.ready.finally(() => liveRow()?.classList.remove("outline"));
    }
    vt.finished.finally(() => liveRow()?.style.removeProperty("view-transition-name"));
  });
</script>

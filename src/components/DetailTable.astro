---
import { type DetailRow, outlineClass, tableWidth } from "../lib/table.ts";
import { rowTransitionName } from "../lib/transitions.ts";

// The static table shared by the detail pages and the entry pages' visit
// lists. Rows carry `data-row-*` hooks: the clicked row tags itself with its
// view-transition-name and navigates; the return is paired in
// `astro:before-swap` from the incoming document. The islands
// (SortableTable.tsx) tag their rows with the same hooks, so this one script
// drives every table's morphs.
interface Props {
  headers: string[];
  rows: DetailRow[];
  colWidths: readonly string[];
  headVt: string;
  // Tailwind max-width class for the wrapper.
  maxWidth: string;
  // Single-row detail page: the row always shows its outline, carries its
  // transition name up front, and clicking it navigates back to `backHref`.
  detail?: boolean;
  backHref?: string;
  // Flash the outline of a row targeted by a return morph during the swap.
  flourish?: boolean;
}

const { headers, rows, colWidths, headVt, maxWidth, detail = false, backHref, flourish = false } =
  Astro.props;
---

{/* relative: paint above the persisted fixed map layer, like the page text. */}
<section class={`relative ${maxWidth} overflow-x-auto px-4 py-4 sm:px-8`}>
  <table class="table-fixed border-collapse text-base" style={`width:${tableWidth(colWidths)}`}>
    <colgroup>{colWidths.map((w) => <col style={`width:${w}`} />)}</colgroup>
    <thead>
      <tr class="text-left" transition:name={headVt}>
        {headers.map((header) => <th class="truncate py-1 pr-4 text-sm font-normal first:pl-4">{header}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => {
          const vt = rowTransitionName(row.href);
          // The name cell's <a> carries the same target as the row so it works
          // without the script (keyboard, screen readers, open-in-new-tab);
          // the script upgrades plain clicks to a ClientRouter navigation.
          const target = detail && backHref ? backHref : row.href;
          const cls = `cursor-pointer -outline-offset-1 ${outlineClass(row.category)} ${
            detail ? "outline" : "hover:outline"
          }`;
          const cells = row.cells.map((cell) => (
            <td class="truncate py-1 pr-4 text-sm first:pl-4">
              {
                cell.strong ? (
                  <a href={target} class="font-medium">
                    {cell.text}
                  </a>
                ) : (
                  cell.text
                )
              }
            </td>
          ));
          // The detail row carries its transition name up front; list rows get
          // theirs from JS on click.
          return detail ? (
            <tr
              data-row-nav
              data-row-detail
              data-row-href={row.href}
              data-row-back={backHref}
              data-marker-href={row.markerHref}
              transition:name={vt}
              class={cls}
            >
              {cells}
            </tr>
          ) : (
            <tr
              data-row-nav
              data-row-href={row.href}
              data-row-flourish={flourish ? "" : undefined}
              data-marker-href={row.markerHref}
              class={cls}
            >
              {cells}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</section>

<script>
  // Rebind on each swap since rows are fresh DOM; a dataset flag guards
  // against double-binding.
  import { navigate } from "astro:transitions/client";

  import { normalizePath } from "../lib/routes.ts";
  import { navigateWithRowMorph } from "../lib/row-morph.ts";
  import { $hovered } from "../lib/stores.ts";
  import { rowTransitionName } from "../lib/transitions.ts";

  function bindRows() {
    for (const row of document.querySelectorAll<HTMLElement>("[data-row-nav]")) {
      if (row.dataset.bound) continue;
      row.dataset.bound = "1";
      // Rows carrying a marker key share hover state with the map island,
      // like the home table's rows.
      const markerHref = row.dataset.markerHref;
      if (markerHref) {
        row.addEventListener("mouseenter", () => $hovered.set(markerHref));
        row.addEventListener("mouseleave", () => $hovered.set(null));
      }
      row.addEventListener("click", (event) => {
        // Let the browser handle modified clicks on the name link (new tab, etc.).
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        // Cancel the name link's full-page navigation; the ClientRouter keeps
        // the persisted map alive.
        event.preventDefault();
        if (row.hasAttribute("data-row-detail")) {
          navigate(row.dataset.rowBack!);
        } else {
          navigateWithRowMorph(row.dataset.rowHref!);
        }
      });
    }
  }

  bindRows();
  document.addEventListener("astro:page-load", bindRows);

  // Returning to a list/home page: pair the incoming row matching the page
  // we're leaving (same transition name) so the detail row morphs back into
  // its slot; clean up the injected name once the animation finishes.
  document.addEventListener("astro:before-swap", (event) => {
    const from = normalizePath(event.from.pathname);
    const row = event.newDocument.querySelector<HTMLElement>(`[data-row-href="${from}"]`);
    if (!row) return;
    row.style.setProperty("view-transition-name", rowTransitionName(from));

    const vt = event.viewTransition;
    if (!vt) return;
    const liveRow = () => document.querySelector<HTMLElement>(`[data-row-href="${from}"]`);
    if (row.hasAttribute("data-row-flourish")) {
      row.classList.add("outline");
      vt.ready.finally(() => liveRow()?.classList.remove("outline"));
    }
    vt.finished.finally(() => liveRow()?.style.removeProperty("view-transition-name"));
  });
</script>

---
// Importing the stylesheet here bundles maplibre's CSS into the page.
import "maplibre-gl/dist/maplibre-gl.css";
---

<div id="entries-map" class="h-full w-full"></div>

<script>
  // The map is lazy: maplibre (~1 MB, code-split — see docs/issues/0001)
  // and /map-markers.json are
  // fetched only when a page that shows the map is first shown. The type-only
  // maplibre imports below are erased at build time and don't pull the chunk.
  import { navigate, type TransitionBeforePreparationEvent } from "astro:transitions/client";
  import type { Map as MapLibreMap, Marker } from "maplibre-gl";
  import { FULLSCREEN_MAP_PATHS, MAP_LAYER_ID, MAP_MARKERS_URL, MARKER_COLORS, type MapEntry } from "../lib/map.ts";
  import { normalizePath } from "../lib/routes.ts";
  import { navigateWithRowMorph } from "../lib/row-morph.ts";
  import { $hovered } from "../lib/stores.ts";

  const STYLE_URL = "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json";
  const FALLBACK_CENTER: [number, number] = [130.7417, 32.7898]; // Kumamoto City
  const FALLBACK_ZOOM = 8;
  // Side (CSS px) of the square the map is cropped to on detail pages.
  const FOCUS_CLIP_SIZE = 256;

  function currentPath(): string {
    return normalizePath(location.pathname);
  }

  async function initMap(container: HTMLElement): Promise<MapLibreMap> {
    const [{ default: maplibregl }, entries] = await Promise.all([
      import("maplibre-gl"),
      fetch(MAP_MARKERS_URL).then((res) => res.json() as Promise<MapEntry[]>),
    ]);

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: FALLBACK_CENTER,
      zoom: FALLBACK_ZOOM,
    });
    map.addControl(new maplibregl.NavigationControl(), "top-right");

    const markers = new Map<string, Marker>();
    const bounds = new maplibregl.LngLatBounds();
    // Markers arrive in stacking order; register in that order so later ones
    // paint on top.
    for (const entry of entries) {
      const lngLat: [number, number] = [entry.lng, entry.lat];

      // Focusable button so the map is keyboard-operable, mirroring the table links.
      const element = document.createElement("div");
      element.className = "map-marker";
      element.setAttribute("role", "button");
      element.setAttribute("tabindex", "0");
      element.setAttribute("aria-label", entry.name);
      // The marker key, read back by syncVisibility's hover re-seed below.
      element.dataset.href = entry.href;
      const dot = document.createElement("div");
      dot.className = entry.visited ? "map-marker-dot map-marker-visited" : "map-marker-dot";
      dot.style.setProperty("--marker-color", MARKER_COLORS[entry.category]);
      element.appendChild(dot);

      const marker = new maplibregl.Marker({ element }).setLngLat(lngLat).addTo(map);
      element.addEventListener("mouseenter", () => $hovered.set({ marker: entry.href }));
      element.addEventListener("mouseleave", () => $hovered.set(null));
      // Keyboard focus shares the hover highlight, on the marker and its table row.
      element.addEventListener("focus", () => $hovered.set({ marker: entry.href }));
      element.addEventListener("blur", () => $hovered.set(null));
      // A marker acts like its entry's table row on the current page: on the
      // entry's own detail page it navigates back home, everywhere else to the
      // entry's page with the same row morph a direct row click gets.
      const activate = () => {
        if (currentPath() === entry.href) {
          navigate("/");
          return;
        }
        navigateWithRowMorph(entry.href);
      };
      element.addEventListener("click", activate);
      element.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        activate();
      });
      markers.set(entry.href, marker);
      bounds.extend(lngLat);
    }
    // No animation: the caller may project marker positions (for the detail-page
    // clip) as soon as this resolves, which needs the final camera transform.
    if (!bounds.isEmpty()) map.fitBounds(bounds, { padding: 64, maxZoom: 12, animate: false });

    // A marker is highlighted while its table row (or itself) is hovered, and
    // always when it is the current detail page's focused entry.
    const updateHighlight = () => {
      const hovered = $hovered.get()?.marker ?? null;
      const focused = currentFocusHref();
      // pendingPath only bridges the gap while nothing is hovered; once the
      // user actively hovers something it is obsolete (and a stale one must
      // not double-highlight alongside it).
      const pending = hovered === null ? pendingPath : null;
      for (const [key, marker] of markers) {
        const active = key === hovered || key === focused || key === pending;
        marker.getElement().classList.toggle("marker-active", active);
      }
    };
    refreshMarkerHighlight = updateHighlight;
    $hovered.subscribe(updateHighlight);

    // A detail page shows only the focused entry's marker, mirroring the
    // single-row detail table; the fullscreen pages show every marker.
    const updateVisibility = () => {
      const focused = currentFocusHref();
      for (const [key, marker] of markers) {
        marker.getElement().style.display = focused && key !== focused ? "none" : "";
      }
    };
    refreshMarkerVisibility = updateVisibility;
    updateVisibility();

    return map;
  }

  // The layer persists across navigation (transition:persist), so this script
  // runs once; the layout hides it server-side off the fullscreen pages (see
  // Base.astro and docs/issues/0002). The
  // camera never moves on navigation: a detail page (<body> carries
  // data-map-lat/lng/href) keeps the fullscreen layer put and clip-path crops
  // it to a square around the focused marker.
  const container = document.getElementById("entries-map");
  const layer = document.getElementById(MAP_LAYER_ID);
  let map: MapLibreMap | null = null;
  let initStarted = false;
  let refreshMarkerHighlight: (() => void) | null = null;
  let refreshMarkerVisibility: (() => void) | null = null;
  // The in-flight navigation target. Between click and swap the view-transition
  // overlay steals the hit test, firing mouseleave on the hovered marker/row,
  // so the ring would drop out of the old page's snapshot and flicker. Keeping
  // the destination highlighted bridges that gap; syncVisibility clears it.
  let pendingPath: string | null = null;
  document.addEventListener("astro:before-preparation", (event) => {
    pendingPath = normalizePath((event as TransitionBeforePreparationEvent).to.pathname);
  });

  function currentFocus(): [number, number] | null {
    const { mapLat, mapLng } = document.body.dataset;
    if (mapLat === undefined || mapLng === undefined) return null;
    return [Number(mapLng), Number(mapLat)];
  }

  // The focused entry's marker key — on /status/<id> it differs from the page path.
  function currentFocusHref(): string | null {
    return document.body.dataset.mapHref ?? null;
  }

  // Re-reads the DOM because it is also called asynchronously (after init, on
  // map resize) — the user may have navigated meanwhile. clip-path also clips
  // hit-testing, so the cropped-away area cannot block clicks on the page.
  function applyClip() {
    if (!layer || !container || !map) return;
    const focus = currentFocus();
    if (!focus) {
      layer.style.clipPath = "";
      return;
    }
    const point = map.project(focus);
    const { width, height } = container.getBoundingClientRect();
    const half = FOCUS_CLIP_SIZE / 2;
    layer.style.clipPath =
      `inset(${point.y - half}px ${width - point.x - half}px ` +
      `${height - point.y - half}px ${point.x - half}px)`;
  }

  function syncVisibility() {
    if (!layer || !container) return;
    // The new page's <body> focus attributes are authoritative from here on.
    pendingPath = null;
    // A swap fires no mouseleave for the elements it removed (boundary events
    // wait for the next pointer move), so $hovered can still hold a row from
    // the page just left. Re-seed it from the persisted markers — the only
    // elements whose hover/focus genuinely survives a swap.
    const marker =
      container.querySelector<HTMLElement>(".map-marker:hover") ??
      container.querySelector<HTMLElement>(".map-marker:focus");
    const markerHref = marker?.dataset.href;
    $hovered.set(markerHref !== undefined ? { marker: markerHref } : null);
    const focus = currentFocus();
    if (!FULLSCREEN_MAP_PATHS.includes(currentPath()) && !focus) {
      layer.style.display = "none";
      return;
    }
    if (map) {
      layer.style.display = "";
      // The container may have been hidden (display:none has no dimensions) or
      // resized meanwhile. resize() fires "resize" synchronously and applyClip
      // is subscribed to it, so the crop is reapplied without an explicit call.
      map.resize();
      refreshMarkerHighlight?.();
      refreshMarkerVisibility?.();
      return;
    }
    // First init: the layer must be displayed for maplibre to see the
    // container's dimensions, so until the clip can be computed keep it fully
    // clipped — an unclipped empty layer would block a detail page's links.
    layer.style.display = "";
    layer.style.clipPath = focus ? "inset(100%)" : "";
    if (initStarted) return; // in flight; applyClip runs when it resolves
    initStarted = true;
    initMap(container).then(
      (created) => {
        map = created;
        // Viewport resizes shift the marker's on-screen position; keep the crop in place.
        map.on("resize", applyClip);
        applyClip();
      },
      // Fetch failed (offline?): allow a retry on a later navigation.
      () => {
        initStarted = false;
      },
    );
  }
  document.addEventListener("astro:after-swap", syncVisibility);
  syncVisibility();
</script>

---
import { render } from "astro:content";

import Base from "../layouts/Base.astro";
import { type ActiveEntry, sourceLink } from "../lib/catalog.ts";
import { entryMapFocus, toEntryRow } from "../lib/entries.ts";
import { toStatusRow } from "../lib/status.ts";
import DetailBody from "./DetailBody.astro";
import EntryDetailTable from "./EntryDetailTable.astro";
import StatusDetailTable from "./StatusDetailTable.astro";

// Shared shell for an Entry's detail page (/projects/<id>, /kap92/<id>).
interface Props {
  entry: ActiveEntry;
  // Status ids that visited this entry, newest first.
  visits?: string[];
}

const { entry, visits = [] } = Astro.props;
const { Content } = await render(entry);

const row = toEntryRow(entry);
const source = sourceLink(entry);
const visitRows = visits.map((id) => toStatusRow(id, entry));
---

<Base title={`Kumamoto Artpolis > ${entry.data.name}`} mapFocus={entryMapFocus(entry)}>
  <Fragment slot="entry">
    <EntryDetailTable rows={[row]} />
    <DetailBody>
      {/* The source page is frontmatter (the tool fetches from it); the PDF
          links and everything else are hand-written in the body. */}
      {
        source && (
          <ul>
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          </ul>
        )
      }
      <Content />
    </DetailBody>
  </Fragment>
  <Fragment slot="status">
    {/* Deliberately rendered even with zero visits: the header keeps the
        status slot's layout and its STATUS_HEAD_VT morph pair present on
        every entry page. */}
    <StatusDetailTable rows={visitRows} />
  </Fragment>
</Base>

---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Base from "../layouts/Base.astro";
import { toEntryRow } from "../lib/entries.ts";
import { toStatusRow } from "../lib/status.ts";
import EntryDetailTable from "./EntryDetailTable.astro";
import StatusTable from "./StatusTable.astro";

// Shared shell for a single Entry's detail page (/projects/<id>, /kap92/<id>).
// Both routes render the same layout into Base's slots: the persisted map
// cropped to the entry's marker; under the wordmark a one-row EntryDetailTable
// and the entry body; under the Status link this entry's visit rows as a
// StatusTable (both collections can be visited). `visits` are the status
// record ids (ISO datetimes) that visited this entry, newest first; each
// timeline row links to `/status/<id>`.
interface Props {
  entry: CollectionEntry<"projects"> | CollectionEntry<"kap92">;
  visits?: string[];
}

const { entry, visits = [] } = Astro.props;
const { Content } = await render(entry);

const row = toEntryRow(entry);
const visitRows = visits.map((id) => toStatusRow(id, entry));
---

<Base
  title={`Kumamoto Artpolis > ${entry.data.name}`}
  mapFocus={{ lat: entry.data.lat, lng: entry.data.lng, href: row.href }}
>
  <Fragment slot="entry">
    <EntryDetailTable rows={[row]} />
    {/* relative stacks the text above the persisted fixed map layer (positioned
        elements paint over it in tree order); pointer-events-none + auto children
        let clicks in the gaps still reach the map square behind. */}
    <main class="pointer-events-none relative max-w-2xl p-4 sm:p-8">
      <h1 class="pointer-events-auto text-base font-bold">{entry.data.name}</h1>

      <div class="pointer-events-auto mt-6 text-gray-800">
        <Content />
      </div>
    </main>
  </Fragment>
  <Fragment slot="status">
    {visitRows.length > 0 && <StatusTable rows={visitRows} />}
  </Fragment>
</Base>

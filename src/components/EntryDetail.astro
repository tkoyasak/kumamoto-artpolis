---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Base from "../layouts/Base.astro";
import { toExplorerRow } from "../lib/explorer.ts";
import ExplorerTable from "./ExplorerTable.astro";

// Shared shell for a single Entry's detail page (/projects/<slug>, /kap92/<slug>).
// Both routes render the same layout: the persisted map cropped to the entry's
// marker, a one-row ExplorerTable, the entry body, and its visit records. Both
// collections can be visited, so the visit section lives here. `visits` are the
// status record ids (ISO datetimes) that visited this entry, newest first: each
// links to `/status/<id>` and shows its date via `id.slice(0, 10)`; the row only
// needs the latest date.
interface Props {
  entry: CollectionEntry<"projects"> | CollectionEntry<"kap92">;
  visits?: string[];
}

const { entry, visits = [] } = Astro.props;
const { Content } = await render(entry);

const row = toExplorerRow(entry, visits[0] ? visits[0].slice(0, 10) : null);
---

<Base
  title={`Kumamoto Artpolis > ${entry.data.name}`}
  mapFocus={{ lat: entry.data.lat, lng: entry.data.lng }}
>
  <ExplorerTable rows={[row]} />
  {/* relative stacks the text above the persisted fixed map layer (positioned
      elements paint over it in tree order); pointer-events-none + auto children
      let clicks in the gaps still reach the map square behind. */}
  <main class="pointer-events-none relative max-w-2xl p-4 sm:p-8">
    <h1 class="pointer-events-auto text-base font-bold">{entry.data.name}</h1>

    <div class="pointer-events-auto mt-6 text-gray-800">
      <Content />
    </div>

    <section class="pointer-events-auto mt-8">
      <h2 class="text-base font-semibold">訪問記録</h2>
      {
        visits.length > 0 ? (
          <ul class="mt-2 space-y-1 text-base">
            {visits.map((id) => (
              <li>
                <a href={`/status/${id}`} class="text-rose-600 hover:underline">
                  {id.slice(0, 10)}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-2 text-gray-500">まだ訪問記録がありません。</p>
        )
      }
    </section>
  </main>
</Base>

---
import type { EntryRow } from "../lib/entries.ts";
import { type DetailRow, ENTRY_COL_WIDTHS } from "../lib/table.ts";
import { ENTRY_HEAD_VT } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Static counterpart to the interactive home table (EntriesTable.tsx), shown on
// detail pages as a header + one row. Maps the EntryRow into DetailTable's row
// shape; DetailTable owns the markup and the View Transition morph back to the
// home table (clicking the row navigates to "/").
interface Props {
  rows: EntryRow[];
}

const { rows } = Astro.props;

const headers = ["No.", "Name", "Architects", "Use", "Location", "Year", "Visited"];

const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  category: row.category,
  cells: [
    { text: String(row.number) },
    { text: row.name, strong: true },
    { text: row.architects.join(", ") },
    { text: row.use },
    { text: row.municipality },
    { text: row.completedYear != null ? String(row.completedYear) : "" },
    { text: row.visitedDate ?? "" },
  ],
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={ENTRY_COL_WIDTHS}
  headVt={ENTRY_HEAD_VT}
  maxWidth="max-w-5xl"
  detail
  backHref="/"
/>

---
import type { EntryRow } from "../lib/entries.ts";
import {
  type DetailRow,
  ENTRY_COL_WIDTHS,
  ENTRY_HEADERS,
  ENTRY_MOBILE_COLS,
  entryDetailCells,
} from "../lib/table.ts";
import { ENTRY_HEAD_VT } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Static counterpart to the home table (EntriesTable.tsx): header + one row.
interface Props {
  rows: EntryRow[];
  // False on /status/<id>, where the row is the *visited* entry, not the page's
  // subject: it renders list-style and clicks through to the entry's page.
  subject?: boolean;
}

const { rows, subject = true } = Astro.props;

const headers = Object.values(ENTRY_HEADERS);

const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  category: row.category,
  cells: entryDetailCells(row),
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={ENTRY_COL_WIDTHS}
  mobileCols={ENTRY_MOBILE_COLS}
  headVt={ENTRY_HEAD_VT}
  subject={subject}
  backHref="/"
/>

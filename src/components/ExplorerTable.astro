---
import type { ExplorerRow } from "../lib/explorer.ts";
import type { DetailRow } from "../lib/table.ts";
import { EXPLORER_COL_WIDTHS, EXPLORER_HEAD_VT, rowTransitionName } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Static counterpart to the interactive home table (ProjectsTable.tsx), shown on
// detail pages as a header + one row. Maps the ExplorerRow into DetailTable's row
// shape; DetailTable owns the markup and the View Transition morph back to the
// home table (clicking the row navigates to "/").
interface Props {
  rows: ExplorerRow[];
}

const { rows } = Astro.props;

const headers = ["No.", "Name", "Architects", "Use", "Location", "Year", "Visited"];

const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  vt: rowTransitionName(row.href),
  category: row.category,
  cells: [
    { text: String(row.number) },
    { text: row.name, strong: true },
    { text: row.architects.join(", ") },
    { text: row.use },
    { text: row.municipality },
    { text: row.completedYear != null ? String(row.completedYear) : "" },
    { text: row.visitedDate ?? "" },
  ],
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={EXPLORER_COL_WIDTHS}
  headVt={EXPLORER_HEAD_VT}
  maxWidth="max-w-5xl"
  detail
  backHref="/"
/>

---
import type { ExplorerRow } from "../lib/explorer.ts";
import {
  EXPLORER_COL_WIDTHS,
  EXPLORER_HEAD_VT,
  EXPLORER_TABLE_WIDTH,
  rowTransitionName,
} from "../lib/transitions.ts";

// Static counterpart to the interactive home explorer table (ProjectsTable.tsx):
// same styling, but no sorting/hover/map linkage. Used on detail pages to show a
// single entry as a header + one row. The header and the row carry shared View
// Transition names so the home table morphs into this one on navigation.
interface Props {
  rows: ExplorerRow[];
}

const { rows } = Astro.props;

const headers = ["No.", "Name", "Architects", "Use", "Location", "Year", "Visited"];
---

<section class="max-w-5xl overflow-x-auto p-4 sm:p-8">
  <table class="table-fixed border-collapse text-base" style={`width:${EXPLORER_TABLE_WIDTH}`}>
    <colgroup>{EXPLORER_COL_WIDTHS.map((w) => <col style={`width:${w}`} />)}</colgroup>
    <thead>
      <tr class="text-left" transition:name={EXPLORER_HEAD_VT}>
        {
          headers.map((header) => (
            <th class="truncate py-1 pr-4 font-normal first:pl-4">{header}</th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            transition:name={rowTransitionName(row.href)}
            data-home-row
            class={`cursor-pointer outline -outline-offset-1 ${
              row.category === "kap92" ? "outline-kap92" : "outline-project"
            }`}
          >
            <td class="truncate py-1 pr-4 text-sm first:pl-4">{row.number}</td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">
              <span class="font-medium">{row.name}</span>
            </td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">
              {row.architects.join(", ")}
            </td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">{row.use}</td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">{row.municipality}</td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">{row.completedYear ?? ""}</td>
            <td class="truncate py-1 pr-4 text-sm first:pl-4">{row.visitedDate ?? ""}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<script>
  // The detail-page row navigates back to the home explorer (via the ClientRouter,
  // so the shared transition names animate). Rebind on each swap since the row is
  // fresh DOM; a dataset flag guards against double-binding on the same element.
  import { navigate } from "astro:transitions/client";
  import { rowTransitionName } from "../lib/transitions.ts";

  function bindHomeRows() {
    for (const row of document.querySelectorAll<HTMLElement>("[data-home-row]")) {
      if (row.dataset.bound) continue;
      row.dataset.bound = "1";
      row.addEventListener("click", () => navigate("/"));
    }
  }

  bindHomeRows();
  document.addEventListener("astro:page-load", bindHomeRows);

  // Returning to the home page: pair the detail row with its home slot (same
  // transition name) so it morphs back into place. Show the outline for the morph
  // only — include it in the captured "new" snapshot, then strip it from the live
  // row once the snapshot is taken (transition ready), so it is gone the instant
  // the row settles. Clean up the transition name after the animation finishes.
  document.addEventListener("astro:before-swap", (event) => {
    if (event.to.pathname !== "/") return;
    const fromPath = event.from.pathname;
    const row = event.newDocument.querySelector<HTMLElement>(`[data-row-href="${fromPath}"]`);
    if (!row) return;

    row.style.setProperty("view-transition-name", rowTransitionName(fromPath));

    const vt = event.viewTransition;
    if (!vt) return; // no View Transitions support: skip the outline flourish
    row.classList.add("outline");

    const liveRow = () => document.querySelector<HTMLElement>(`[data-row-href="${fromPath}"]`);
    vt.ready.finally(() => liveRow()?.classList.remove("outline"));
    vt.finished.finally(() => liveRow()?.style.removeProperty("view-transition-name"));
  });
</script>

---
// Site footer: secondary nav stacked vertically, left-aligned.
const links = [
  { href: "/status", label: "Status" },
  { href: "/about", label: "About" },
];
---

<footer class="pointer-events-none relative z-20">
  <nav
    class="flex max-w-5xl flex-col items-start gap-y-2 p-4 font-medium text-base text-neutral-900 sm:px-8"
  >
    {
      links.map((link) => (
        <a href={link.href} class="pointer-events-auto">
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>

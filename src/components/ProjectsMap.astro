---
// Importing the stylesheet here bundles maplibre's CSS into the page.
import "maplibre-gl/dist/maplibre-gl.css";
---

<div id="projects-map" class="h-full w-full"></div>

<script>
  // The map is lazy: maplibre (~1 MB, code-split — see manualChunks in
  // astro.config.ts and issues/maplibre-chunk-loading.md) and the marker data
  // (/map-data.json, a prerendered endpoint) are fetched only when "/" is first
  // shown, so direct visits to other pages never pay for the map. The type-only
  // maplibre imports below are erased at build time and don't pull the chunk.
  import { navigate } from "astro:transitions/client";
  import type { Map as MapLibreMap, Marker } from "maplibre-gl";
  import { MAP_DATA_URL, type MapProject } from "../lib/map.ts";
  import { $hovered } from "../lib/stores.ts";
  import { MAP_LAYER_ID, rowTransitionName } from "../lib/transitions.ts";

  const STYLE_URL = "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json";
  const FALLBACK_CENTER: [number, number] = [130.7417, 32.7898]; // Kumamoto City
  const FALLBACK_ZOOM = 8;

  // Color encodes the collection; fill (below) encodes visited status.
  // Keep in sync with --color-project / --color-kap92 in global.css (used for the table hover).
  const COLOR_PROJECT = "#ff5031";
  const COLOR_KAP92 = "#0009f3";

  function markerColor(project: MapProject): string {
    return project.category === "kap92" ? COLOR_KAP92 : COLOR_PROJECT;
  }

  async function initMap(container: HTMLElement): Promise<MapLibreMap> {
    const [{ default: maplibregl }, projects] = await Promise.all([
      import("maplibre-gl"),
      fetch(MAP_DATA_URL).then((res) => res.json() as Promise<MapProject[]>),
    ]);

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: FALLBACK_CENTER,
      zoom: FALLBACK_ZOOM,
    });
    map.addControl(new maplibregl.NavigationControl(), "top-right");

    const markers = new Map<string, Marker>();
    const bounds = new maplibregl.LngLatBounds();
    // Register in reverse so earlier entries (projects) are added last and sit on top of KAP'92.
    for (const project of [...projects].reverse()) {
      const lngLat: [number, number] = [project.lng, project.lat];
      const color = markerColor(project);

      // Custom square marker: outlined in the collection color, filled when visited.
      const element = document.createElement("div");
      element.className = "map-marker";
      const dot = document.createElement("div");
      dot.className = "map-marker-dot";
      dot.style.setProperty("--marker-color", color);
      dot.style.backgroundColor = project.visited ? color : "transparent";
      element.appendChild(dot);

      const marker = new maplibregl.Marker({ element }).setLngLat(lngLat).addTo(map);
      element.addEventListener("mouseenter", () => $hovered.set(project.href));
      element.addEventListener("mouseleave", () => $hovered.set(null));
      // Navigate via the ClientRouter (like the table rows) so the persisted map
      // survives the trip — window.location would full-reload and rebuild it.
      // Tag the entry's table row (markers are only clickable on the home page,
      // where every row is rendered) so it morphs into the detail-page row, the
      // same View Transition a direct row click gets.
      element.addEventListener("click", () => {
        document
          .querySelector<HTMLElement>(`[data-row-href="${project.href}"]`)
          ?.style.setProperty("view-transition-name", rowTransitionName(project.href));
        navigate(project.href);
      });
      markers.set(project.href, marker);
      bounds.extend(lngLat);
    }
    if (!bounds.isEmpty()) map.fitBounds(bounds, { padding: 64, maxZoom: 12 });

    // Reflect the shared hovered key (set by the table) onto the markers.
    $hovered.subscribe((href) => {
      for (const [key, marker] of markers) {
        marker.getElement().classList.toggle("marker-active", key === href);
      }
    });

    return map;
  }

  // The map layer persists across navigation (transition:persist), so this script
  // runs once. The layout hides the layer server-side off "/" (so it can't block
  // clicks before this script runs); from here on visibility is toggled per
  // navigation. The map is initialized on the first navigation that shows it and
  // resized on later returns, since a hidden container has no dimensions.
  const container = document.getElementById("projects-map");
  const layer = document.getElementById(MAP_LAYER_ID);
  let map: MapLibreMap | null = null;
  let initStarted = false;

  function syncVisibility() {
    const onHome = location.pathname === "/";
    if (layer) layer.style.display = onHome ? "" : "none";
    if (!onHome || !container) return;
    if (initStarted) {
      map?.resize();
      return;
    }
    initStarted = true;
    initMap(container).then(
      (created) => {
        map = created;
      },
      // Fetch failed (offline?): allow a retry on a later navigation home.
      () => {
        initStarted = false;
      },
    );
  }
  document.addEventListener("astro:after-swap", syncVisibility);
  syncVisibility();
</script>

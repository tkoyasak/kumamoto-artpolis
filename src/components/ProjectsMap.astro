---
// Importing the stylesheet here bundles maplibre's CSS into the page.
import "maplibre-gl/dist/maplibre-gl.css";
---

<div id="projects-map" class="h-full w-full"></div>
{/* Detail-page overlay: an invisible link sitting exactly on the clipped square
    (positioned by the script below). Like the entry's table row, clicking it
    navigates back to the home explorer. It covers the square, so the map is not
    interactive on detail pages. */}
<a id="map-focus-link" href="/" aria-label="一覧へ戻る" class="absolute z-10" style="display:none"
></a>

<script>
  // The map is lazy: maplibre (~1 MB, code-split — see manualChunks in
  // astro.config.ts and issues/maplibre-chunk-loading.md) and the marker data
  // (/map-data.json, a prerendered endpoint) are fetched only when "/" is first
  // shown, so direct visits to other pages never pay for the map. The type-only
  // maplibre imports below are erased at build time and don't pull the chunk.
  import { navigate, type TransitionBeforePreparationEvent } from "astro:transitions/client";
  import type { Map as MapLibreMap, Marker } from "maplibre-gl";
  import { MAP_DATA_URL, type MapProject } from "../lib/map.ts";
  import { $hovered } from "../lib/stores.ts";
  import { MAP_LAYER_ID, rowTransitionName } from "../lib/transitions.ts";

  const STYLE_URL = "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json";
  const FALLBACK_CENTER: [number, number] = [130.7417, 32.7898]; // Kumamoto City
  const FALLBACK_ZOOM = 8;
  // Side (CSS px) of the square the map is cropped to on detail pages.
  const FOCUS_CLIP_SIZE = 256;

  // Color encodes the collection; fill (below) encodes visited status.
  // Keep in sync with --color-project / --color-kap92 in global.css (used for the table hover).
  const COLOR_PROJECT = "#ff5031";
  const COLOR_KAP92 = "#0009f3";

  function markerColor(project: MapProject): string {
    return project.category === "kap92" ? COLOR_KAP92 : COLOR_PROJECT;
  }

  async function initMap(container: HTMLElement): Promise<MapLibreMap> {
    const [{ default: maplibregl }, projects] = await Promise.all([
      import("maplibre-gl"),
      fetch(MAP_DATA_URL).then((res) => res.json() as Promise<MapProject[]>),
    ]);

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: FALLBACK_CENTER,
      zoom: FALLBACK_ZOOM,
    });
    map.addControl(new maplibregl.NavigationControl(), "top-right");

    const markers = new Map<string, Marker>();
    const bounds = new maplibregl.LngLatBounds();
    // Register in reverse so earlier entries (projects) are added last and sit on top of KAP'92.
    for (const project of [...projects].reverse()) {
      const lngLat: [number, number] = [project.lng, project.lat];
      const color = markerColor(project);

      // Custom square marker: outlined in the collection color, filled when visited.
      const element = document.createElement("div");
      element.className = "map-marker";
      const dot = document.createElement("div");
      dot.className = "map-marker-dot";
      dot.style.setProperty("--marker-color", color);
      dot.style.backgroundColor = project.visited ? color : "transparent";
      element.appendChild(dot);

      const marker = new maplibregl.Marker({ element }).setLngLat(lngLat).addTo(map);
      element.addEventListener("mouseenter", () => $hovered.set(project.href));
      element.addEventListener("mouseleave", () => $hovered.set(null));
      // Navigate via the ClientRouter (like the table rows) so the persisted map
      // survives the trip — window.location would full-reload and rebuild it.
      // Tag the entry's table row (markers are only clickable on the home page,
      // where every row is rendered) so it morphs into the detail-page row, the
      // same View Transition a direct row click gets.
      element.addEventListener("click", () => {
        document
          .querySelector<HTMLElement>(`[data-row-href="${project.href}"]`)
          ?.style.setProperty("view-transition-name", rowTransitionName(project.href));
        navigate(project.href);
      });
      markers.set(project.href, marker);
      bounds.extend(lngLat);
    }
    // No animation: the caller may project marker positions (for the detail-page
    // clip) as soon as this resolves, which needs the final camera transform.
    if (!bounds.isEmpty()) map.fitBounds(bounds, { padding: 64, maxZoom: 12, animate: false });

    // A marker is highlighted while its table row (or itself) is hovered, and —
    // always — when it is the current detail page's entry (marker hrefs are the
    // page paths, so the focused marker is the one matching location.pathname).
    // Re-run on hover changes (subscribe) and on navigation (refreshMarkerHighlight
    // is called from syncVisibility below).
    const updateHighlight = () => {
      const hovered = $hovered.get();
      const focused = currentFocus() ? location.pathname : null;
      for (const [key, marker] of markers) {
        const active = key === hovered || key === focused || key === pendingPath;
        marker.getElement().classList.toggle("marker-active", active);
      }
    };
    refreshMarkerHighlight = updateHighlight;
    $hovered.subscribe(updateHighlight);

    return map;
  }

  // The map layer persists across navigation (transition:persist), so this script
  // runs once. The layout hides the layer server-side off "/" (so it can't block
  // clicks before this script runs); from here on this script sets it per
  // navigation. The camera never moves on navigation: on "/" the layer shows
  // fullscreen; on a detail page (<body> carries data-map-lat/lng, see
  // Base.astro's mapFocus prop) the same fullscreen layer stays put and clip-path
  // crops it to a square around the marker at its current on-screen position, so
  // the detail page keeps exactly the view the index showed; elsewhere hidden.
  const container = document.getElementById("projects-map");
  const layer = document.getElementById(MAP_LAYER_ID);
  const focusLink = document.getElementById("map-focus-link");
  let map: MapLibreMap | null = null;
  let initStarted = false;
  // Set by initMap once the markers exist; re-applies the marker highlight
  // (hover + current detail page) after each navigation.
  let refreshMarkerHighlight: (() => void) | null = null;
  // The in-flight navigation target. Between click and swap the view-transition
  // overlay steals the hit test, firing mouseleave on the hovered marker/row —
  // $hovered goes null while the old page (no focus data on <body> yet) is still
  // live and about to be snapshotted, so the ring would drop out of the old
  // snapshot and flicker. Keeping the destination highlighted bridges that gap;
  // syncVisibility clears it once the new page's focus attributes take over.
  let pendingPath: string | null = null;
  document.addEventListener("astro:before-preparation", (event) => {
    pendingPath = (event as TransitionBeforePreparationEvent).to.pathname;
  });

  function currentFocus(): [number, number] | null {
    const { mapLat, mapLng } = document.body.dataset;
    if (mapLat === undefined || mapLng === undefined) return null;
    return [Number(mapLng), Number(mapLat)];
  }

  // Crop the layer to a square around the current page's marker, or uncrop on
  // "/". The focus link overlay is kept congruent with the square: it draws the
  // outline and captures the click back home. Re-reads the DOM because it is
  // also called asynchronously (after init, on map resize) — the user may have
  // navigated meanwhile. clip-path also clips hit-testing, so the cropped-away
  // area cannot block clicks on the page.
  function applyClip() {
    if (!layer || !container || !focusLink || !map) return;
    const focus = currentFocus();
    if (!focus) {
      layer.style.clipPath = "";
      focusLink.style.display = "none";
      return;
    }
    const point = map.project(focus);
    const { width, height } = container.getBoundingClientRect();
    const half = FOCUS_CLIP_SIZE / 2;
    layer.style.clipPath =
      `inset(${point.y - half}px ${width - point.x - half}px ` +
      `${height - point.y - half}px ${point.x - half}px)`;

    // The layer (position: fixed) is the containing block, and its coordinate
    // space is the viewport — same space map.project() returns.
    focusLink.style.display = "";
    focusLink.style.left = `${point.x - half}px`;
    focusLink.style.top = `${point.y - half}px`;
    focusLink.style.width = `${FOCUS_CLIP_SIZE}px`;
    focusLink.style.height = `${FOCUS_CLIP_SIZE}px`;
  }

  function syncVisibility() {
    if (!layer || !container) return;
    // The new page's <body> focus attributes are authoritative from here on.
    pendingPath = null;
    const focus = currentFocus();
    if (location.pathname !== "/" && !focus) {
      layer.style.display = "none";
      return;
    }
    if (map) {
      layer.style.display = "";
      // The container may have been hidden (display:none has no dimensions) or
      // the window resized meanwhile — sync the transform before projecting.
      map.resize();
      applyClip();
      refreshMarkerHighlight?.();
      return;
    }
    // First page that shows the map: initialize it. The layer must be displayed
    // for maplibre to see the container's dimensions, so until the clip can be
    // computed keep it fully clipped instead — an unclipped empty layer would
    // cover a detail page and block its links.
    layer.style.display = "";
    layer.style.clipPath = focus ? "inset(100%)" : "";
    if (initStarted) return; // in flight; applyClip runs when it resolves
    initStarted = true;
    initMap(container).then(
      (created) => {
        map = created;
        // Viewport resizes shift the marker's on-screen position (maplibre
        // observes the container and fires "resize"); keep the crop in place.
        map.on("resize", applyClip);
        applyClip();
      },
      // Fetch failed (offline?): allow a retry on a later navigation.
      () => {
        initStarted = false;
      },
    );
  }
  document.addEventListener("astro:after-swap", syncVisibility);
  syncVisibility();
</script>

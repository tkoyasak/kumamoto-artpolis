---
import type { StatusRow } from "../lib/status.ts";
import {
  type DetailRow,
  STATUS_COL_WIDTHS,
  STATUS_HEADERS,
  statusDetailCells,
} from "../lib/table.ts";
import { STATUS_HEAD_VT } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Static visit-timeline table: /status/<id>'s single row and the entry pages'
// visit lists (the sortable /status timeline is StatusTable.tsx).
interface Props {
  rows: StatusRow[];
  subject?: boolean;
}

const { rows, subject = false } = Astro.props;

const headers = Object.values(STATUS_HEADERS);

// No markerHref here: each row keys to its own href, so the entry page's one
// subject marker doesn't outline its whole visit list. → docs/adr/0010
const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  category: row.category,
  cells: statusDetailCells(row),
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={STATUS_COL_WIDTHS}
  headVt={STATUS_HEAD_VT}
  maxWidth="max-w-2xl"
  subject={subject}
  backHref="/status"
/>

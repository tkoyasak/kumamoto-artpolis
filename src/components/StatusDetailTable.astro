---
import type { StatusRow } from "../lib/status.ts";
import { type DetailRow, STATUS_COL_WIDTHS } from "../lib/table.ts";
import { STATUS_HEAD_VT } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Static visit-timeline table: the single row on /status/<id> and the visit
// lists on entry pages (the sortable /status timeline is StatusTable.tsx). A
// row's outline is its visited entry's collection color — the same signal the
// entry tables use, so a date row needs no third color.
interface Props {
  rows: StatusRow[];
  subject?: boolean;
}

const { rows, subject = false } = Astro.props;

const headers = ["Date", "Name"];

const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  category: row.category,
  cells: [{ text: row.date }, { text: row.name, strong: true }],
  markerHref: row.entryHref,
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={STATUS_COL_WIDTHS}
  headVt={STATUS_HEAD_VT}
  maxWidth="max-w-2xl"
  subject={subject}
  backHref="/status"
/>

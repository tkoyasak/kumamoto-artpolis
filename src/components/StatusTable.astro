---
import type { StatusRow } from "../lib/status.ts";
import type { DetailRow } from "../lib/table.ts";
import { STATUS_COL_WIDTHS, STATUS_HEAD_VT, statusRowTransitionName } from "../lib/transitions.ts";
import DetailTable from "./DetailTable.astro";

// Visit-timeline table, shared by /status (all rows) and /status/<id> (a single
// row above the visit body). Maps the StatusRow into DetailTable's row shape;
// DetailTable owns the markup and the morph between the list and the detail row.
// Each row's outline is its visited entry's collection color (project = red,
// kap92 = blue) — the same signal the entry tables use, so a date row needs
// no third color.
interface Props {
  rows: StatusRow[];
  // When true this is the single-row detail on /status/<id>: the row shows its
  // outline always and clicking it navigates back to /status.
  detail?: boolean;
}

const { rows, detail = false } = Astro.props;

const headers = ["Date", "Name"];

const detailRows: DetailRow[] = rows.map((row) => ({
  href: row.href,
  vt: statusRowTransitionName(row.id),
  category: row.category,
  cells: [{ text: row.date }, { text: row.name, strong: true }],
}));
---

<DetailTable
  headers={headers}
  rows={detailRows}
  colWidths={STATUS_COL_WIDTHS}
  headVt={STATUS_HEAD_VT}
  maxWidth="max-w-2xl"
  detail={detail}
  backHref="/status"
/>

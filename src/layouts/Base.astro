---
import { ClientRouter } from "astro:transitions";
import EntriesMap from "../components/EntriesMap.astro";
import { FULLSCREEN_MAP_PATHS, MAP_LAYER_ID } from "../lib/map.ts";
import { normalizePath } from "../lib/routes.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Set by detail pages: the focused entry's coordinates and marker key,
  // carried on <body> data attributes for the map script (EntriesMap.astro).
  mapFocus?: { lat: number; lng: number; href: string };
}

const {
  title = "Kumamoto Artpolis",
  description = "くまもとアートポリス",
  mapFocus,
} = Astro.props;

// Exact match through normalizePath, so aria-current holds under the
// trailing-slash URLs Astro's directory build emits (/about/, /status/) but
// never claims a section's subpages.
const path = normalizePath(Astro.url.pathname);
const ariaCurrent = (href: string): "page" | undefined =>
  path === href ? "page" : undefined;

// The map layer lives in the layout so its maplibre instance survives
// navigation (docs/adr/0005); hidden server-side off the fullscreen pages
// (client-side-only hiding blocked clicks until the script ran).
const fullscreenMap = FULLSCREEN_MAP_PATHS.includes(path);

// `w-fit` leaves the rest of each line click-through to the map layer below;
// `z-20` paints the text above it. Below sm the interleaved links give way to
// the fixed nav bar; display:none keeps their transition names out of the
// view transition there.
const navLink = "relative z-20 hidden w-fit font-medium text-base sm:block";

// The nav destinations, rendered twice: the below-sm fixed bar and the
// interleaved desktop links.
const navLinks = [
  { href: "/", label: "Kumamoto Artpolis" },
  { href: "/status", label: "Status" },
  { href: "/about", label: "About" },
] as const;
const [navHome, navStatus, navAbout] = navLinks;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class="max-sm:pt-12"
    data-map-lat={mapFocus?.lat}
    data-map-lng={mapFocus?.lng}
    data-map-href={mapFocus?.href}
  >
    <div
      id={MAP_LAYER_ID}
      class="pointer-events-auto fixed inset-0"
      style={fullscreenMap ? undefined : "display:none"}
      transition:persist={MAP_LAYER_ID}
    >
      <EntriesMap />
    </div>

    {/* The below-sm nav: one fixed bar on every page (the interleaved links
        below are display:none there). No background, like the desktop links;
        pointer-events pass through the bar to the map except on the links. */}
    <nav
      data-nav-bar
      class="pointer-events-none fixed inset-x-0 top-0 z-20 flex items-baseline gap-x-4 px-4 py-3 sm:hidden"
    >
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={ariaCurrent(href)}
            class="pointer-events-auto font-medium text-base"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <slot name="top" />

    {/* Stable transition names so the nav links morph to their new vertical
        position as each page injects content between them. */}
    <a
      href={navHome.href}
      transition:name="nav-home"
      aria-current={ariaCurrent(navHome.href)}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>{navHome.label}</a
    >
    <slot name="entry" />

    <a
      href={navStatus.href}
      transition:name="nav-status"
      aria-current={ariaCurrent(navStatus.href)}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>{navStatus.label}</a
    >
    <slot name="status" />

    <a
      href={navAbout.href}
      transition:name="nav-about"
      aria-current={ariaCurrent(navAbout.href)}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>{navAbout.label}</a
    >
    <slot name="about" />
  </body>
</html>

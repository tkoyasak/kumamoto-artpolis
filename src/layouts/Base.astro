---
import { ClientRouter } from "astro:transitions";
import EntriesMap from "../components/EntriesMap.astro";
import { MAP_LAYER_ID } from "../lib/map.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Set by detail pages: the entry's coordinates, carried on <body> data
  // attributes. The map script reads them to keep the persisted fullscreen map
  // in place (camera untouched), clip it to a square around this marker, and
  // keep the marker's outline highlight on.
  mapFocus?: { lat: number; lng: number };
}

const {
  title = "Kumamoto Artpolis",
  description = "くまもとアートポリスの建築と、それらを訪ねた記録。",
  mapFocus,
} = Astro.props;

// One unified nav column — the wordmark (home), Status, About stacked top to
// bottom — with the current page's content (<slot />) injected right after its
// own entry. `section` picks that slot: detail pages (/projects/*, /kap92/*)
// belong to the home group, so their content shows under the wordmark.
// startsWith (not ===) so it holds under the trailing-slash URLs Astro's
// directory build emits (/about/, /status/).
const path = Astro.url.pathname;
const section =
  path.startsWith("/about") ? "about" : path.startsWith("/status") ? "status" : "home";

// The map layer lives in the layout (not the home page) so its maplibre instance
// survives navigation via transition:persist — returning home reuses it instead of
// re-initializing. It is pointer-events-auto and covers the viewport, so off "/"
// it must be hidden server-side — hiding it client-side only (as before) blocked
// all clicks on non-home pages until the map script ran. The map script takes
// over from here (EntriesMap.astro): lazy init, and per-navigation visibility —
// fullscreen on "/", clipped to a square around the marker when the page sets
// `mapFocus`, hidden elsewhere.
const onHome = path === "/";

// Nav links are `w-fit` so only their text sits over the fixed map layer, leaving
// the rest of each line click-through; `z-20` paints them above the map.
const navLink = "relative z-20 block w-fit font-medium text-base text-neutral-900";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-map-lat={mapFocus?.lat} data-map-lng={mapFocus?.lng}>
    <div
      id={MAP_LAYER_ID}
      class="pointer-events-auto fixed inset-0"
      style={onHome ? undefined : "display:none"}
      transition:persist={MAP_LAYER_ID}
    >
      <EntriesMap />
    </div>

    {/* Stable transition names on the whole nav so the links morph to their new
        vertical position across navigation — the active section pushes the ones
        below it down as its content is injected above them. The wordmark stays
        put (always first), so its name just cross-fades it in place. */}
    <a
      href="/"
      transition:name="nav-home"
      aria-current={section === "home" ? "page" : undefined}
      class:list={[navLink, "px-4 pt-4 pb-2 sm:px-8"]}>Kumamoto Artpolis</a
    >
    {section === "home" && <slot />}

    <a
      href="/status"
      transition:name="nav-status"
      aria-current={section === "status" ? "page" : undefined}
      class:list={[navLink, "px-4 py-2 sm:px-8"]}>Status</a
    >
    {section === "status" && <slot />}

    <a
      href="/about"
      transition:name="nav-about"
      aria-current={section === "about" ? "page" : undefined}
      class:list={[navLink, "px-4 py-2 sm:px-8"]}>About</a
    >
    {section === "about" && <slot />}
  </body>
</html>

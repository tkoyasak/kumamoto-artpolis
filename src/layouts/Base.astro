---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import ProjectsMap from "../components/ProjectsMap.astro";
import { MAP_LAYER_ID } from "../lib/transitions.ts";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Kumamoto Artpolis" } = Astro.props;

// The map layer lives in the layout (not the home page) so its maplibre instance
// survives navigation via transition:persist — returning home reuses it instead of
// re-initializing. It is pointer-events-auto and covers the viewport, so off "/"
// it must be hidden server-side — hiding it client-side only (as before) blocked
// all clicks on non-home pages until the map script ran. The map script takes
// over the toggling (and the lazy map init) from here (ProjectsMap.astro).
const onHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div
      id={MAP_LAYER_ID}
      class="pointer-events-auto fixed inset-0"
      style={onHome ? undefined : "display:none"}
      transition:persist={MAP_LAYER_ID}
    >
      <ProjectsMap />
    </div>
    <Header />
    <slot />
  </body>
</html>

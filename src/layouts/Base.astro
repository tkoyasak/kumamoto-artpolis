---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import ProjectsMap from "../components/ProjectsMap.astro";
import { getExplorerRows, toMapProjects } from "../lib/explorer.ts";
import { MAP_LAYER_ID } from "../lib/transitions.ts";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Kumamoto Artpolis" } = Astro.props;

// The map layer lives in the layout (not the home page) so its maplibre instance
// survives navigation via transition:persist — returning home reuses it instead of
// re-initializing. It is shown only on "/" (toggled client-side in ProjectsMap).
const mapProjects = toMapProjects(await getExplorerRows());
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id={MAP_LAYER_ID} class="pointer-events-auto fixed inset-0" transition:persist={MAP_LAYER_ID}>
      <ProjectsMap projects={mapProjects} />
    </div>
    <Header />
    <slot />
  </body>
</html>

---
import { ClientRouter } from "astro:transitions";
import EntriesMap from "../components/EntriesMap.astro";
import { FULLSCREEN_MAP_PATHS, MAP_LAYER_ID } from "../lib/map.ts";
import { normalizePath } from "../lib/routes.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Set by detail pages: the focused entry's coordinates and marker key,
  // carried on <body> data attributes for the map script (EntriesMap.astro).
  mapFocus?: { lat: number; lng: number; href: string };
}

const {
  title = "Kumamoto Artpolis",
  description = "くまもとアートポリス",
  mapFocus,
} = Astro.props;

// startsWith (not ===) so aria-current holds under the trailing-slash URLs
// Astro's directory build emits (/about/, /status/).
const path = Astro.url.pathname;
const section =
  path.startsWith("/about") ? "about" : path.startsWith("/status") ? "status" : "home";

// The map layer lives in the layout so its maplibre instance survives
// navigation (docs/issues/0002); hidden server-side off the fullscreen pages
// (client-side-only hiding blocked clicks until the script ran).
const fullscreenMap = FULLSCREEN_MAP_PATHS.includes(normalizePath(path));

// `w-fit` leaves the rest of each line click-through to the map layer below;
// `z-20` paints the text above it.
const navLink = "relative z-20 block w-fit font-medium text-base";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-map-lat={mapFocus?.lat} data-map-lng={mapFocus?.lng} data-map-href={mapFocus?.href}>
    <div
      id={MAP_LAYER_ID}
      class="pointer-events-auto fixed inset-0"
      style={fullscreenMap ? undefined : "display:none"}
      transition:persist={MAP_LAYER_ID}
    >
      <EntriesMap />
    </div>

    <slot name="top" />

    {/* Stable transition names so the nav links morph to their new vertical
        position as each page injects content between them. */}
    <a
      href="/"
      transition:name="nav-home"
      aria-current={section === "home" ? "page" : undefined}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>Kumamoto Artpolis</a
    >
    <slot name="entry" />

    <a
      href="/status"
      transition:name="nav-status"
      aria-current={section === "status" ? "page" : undefined}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>Status</a
    >
    <slot name="status" />

    <a
      href="/about"
      transition:name="nav-about"
      aria-current={section === "about" ? "page" : undefined}
      class:list={[navLink, "px-4 py-4 sm:px-8"]}>About</a
    >
    <slot name="about" />
  </body>
</html>

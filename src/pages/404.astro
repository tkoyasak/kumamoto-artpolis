---
import Base from "../layouts/Base.astro";

// Prerendered to dist/404.html, which Cloudflare Workers static assets serves
// for unknown paths (wrangler.json `not_found_handling: "404-page"`).
---

<Base title="ページが見つかりません | Kumamoto Artpolis">
  <main class="mx-auto max-w-2xl p-8">
    <a href="/" class="text-base text-rose-600 hover:underline">← トップへ</a>

    <h1 class="mt-4 text-base font-bold">ページが見つかりません</h1>

    <p class="mt-6 text-gray-800">
      お探しのページは存在しないか、移動した可能性があります。
    </p>
  </main>
</Base>

---
import ProjectsTable from "../components/ProjectsTable.tsx";
import Base from "../layouts/Base.astro";
import { getExplorerRows } from "../lib/explorer.ts";

const rows = await getExplorerRows();
---

<Base>
  {/* The map is a fixed fullscreen background rendered by the layout (persisted
      across navigation). The table scrolls on top; overlapping is intentional. */}
  <main class="pointer-events-none relative">
    <ProjectsTable rows={rows} client:load />
  </main>
</Base>

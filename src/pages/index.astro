---
import { getCollection } from "astro:content";
import ProjectsMap from "../components/ProjectsMap.astro";
import ProjectsTable from "../components/ProjectsTable.tsx";
import Base from "../layouts/Base.astro";
import type { ExplorerRow } from "../lib/explorer.ts";
import type { MapProject } from "../lib/map.ts";
import { getVisitDatesByProject } from "../lib/projects.ts";

const projects = await getCollection("projects");
const kap92 = await getCollection("kap92");
const visits = await getVisitDatesByProject();

const projectRows: ExplorerRow[] = projects.map((project) => ({
  href: `/projects/${project.data.slug}`,
  category: "project",
  number: project.data.number,
  name: project.data.name,
  architects: project.data.architects,
  use: project.data.use,
  municipality: project.data.municipality,
  completedYear: project.data.completedYear,
  visitedDate: (visits.get(project.data.slug) ?? [])[0] ?? null,
  lat: project.data.lat,
  lng: project.data.lng,
}));

const kap92Rows: ExplorerRow[] = kap92.map((building) => ({
  href: `/kap92/${building.data.slug}`,
  category: "kap92",
  number: building.data.number,
  name: building.data.name,
  architects: building.data.architects ?? [],
  use: building.data.use ?? "",
  municipality: building.data.municipality ?? "",
  completedYear: building.data.completedYear ?? null,
  visitedDate: null,
  lat: building.data.lat ?? null,
  lng: building.data.lng ?? null,
}));

const rows = [...projectRows, ...kap92Rows].sort((a, b) => {
  if (a.category !== b.category) return a.category === "project" ? -1 : 1;
  return a.number - b.number;
});

// Only entries with coordinates get a marker.
const mapProjects: MapProject[] = [];
for (const row of rows) {
  if (row.lat == null || row.lng == null) continue;
  mapProjects.push({
    href: row.href,
    name: row.name,
    category: row.category,
    completedYear: row.completedYear,
    visited: row.visitedDate != null,
    lat: row.lat,
    lng: row.lng,
  });
}
---

<Base>
  <main>
    <ProjectsMap projects={mapProjects} />
    <ProjectsTable rows={rows} client:load />
  </main>
</Base>

---
import EntriesTable from "../components/EntriesTable.tsx";
import Base from "../layouts/Base.astro";
import { getEntryRows } from "../lib/entries.ts";

const rows = await getEntryRows();
---

<Base>
  {/* The table scrolls over the layout's fixed fullscreen map; overlapping is intentional. */}
  <main slot="entry" class="pointer-events-none relative">
    <EntriesTable rows={rows} client:load />
  </main>
</Base>

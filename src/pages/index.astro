---
import EntriesTable from "../components/EntriesTable.tsx";
import Base from "../layouts/Base.astro";
import { getEntryRows } from "../lib/entries.ts";

const rows = await getEntryRows();
---

<Base>
  {/* The map is a fixed fullscreen background rendered by the layout (persisted
      across navigation). The table scrolls on top; overlapping is intentional. */}
  <main class="pointer-events-none relative">
    <EntriesTable rows={rows} client:load />
  </main>
</Base>

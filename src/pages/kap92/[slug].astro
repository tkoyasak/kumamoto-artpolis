---
import { getCollection, render } from "astro:content";
import ExplorerTable from "../../components/ExplorerTable.astro";
import Base from "../../layouts/Base.astro";
import { toKap92Row } from "../../lib/explorer.ts";

// Prerender one page per KAP'92 selected existing building, keyed by slug.
export async function getStaticPaths() {
  const buildings = await getCollection("kap92");
  return buildings.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const row = toKap92Row(entry);

// KAP'92 entries may lack coordinates — no map focus (map stays hidden) then.
const { lat, lng } = entry.data;
const mapFocus = lat !== undefined && lng !== undefined ? { lat, lng } : undefined;
---

<Base title={`Kumamoto Artpolis > ${entry.data.name}`} mapFocus={mapFocus}>
  <ExplorerTable rows={[row]} />
  {/* relative stacks the text above the persisted fixed map layer (positioned
      elements paint over it in tree order); pointer-events-none + auto children
      let clicks in the gaps still reach the map square behind. */}
  <main class="pointer-events-none relative mx-auto max-w-2xl p-8">
    <a href="/" class="pointer-events-auto text-base text-rose-600 hover:underline">← トップへ</a>

    <h1 class="pointer-events-auto mt-4 text-base font-bold">{entry.data.name}</h1>

    <div class="pointer-events-auto mt-6 text-gray-800">
      <Content />
    </div>
  </main>
</Base>

---
import { getCollection } from "astro:content";
import EntryDetail from "../../components/EntryDetail.astro";
import { getVisitDatesByEntry } from "../../lib/projects.ts";

// Prerender one page per KAP'92 selected existing building, keyed by slug.
export async function getStaticPaths() {
  const buildings = await getCollection("kap92");
  const visits = await getVisitDatesByEntry();
  return buildings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, visitedDates: visits.get(`/kap92/${entry.id}`) ?? [] },
  }));
}

const { entry, visitedDates } = Astro.props;
---

<EntryDetail entry={entry} visitedDate={visitedDates[0] ?? null}>
  <section class="pointer-events-auto mt-8">
    <h2 class="text-base font-semibold">訪問記録</h2>
    {
      visitedDates.length > 0 ? (
        <ul class="mt-2 space-y-1 text-base">
          {visitedDates.map((date) => (
            <li>
              <a href={`/status/${date}`} class="text-rose-600 hover:underline">
                {date}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2 text-gray-500">まだ訪問記録がありません。</p>
      )
    }
  </section>
</EntryDetail>

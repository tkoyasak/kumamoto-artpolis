---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

// Prerender one page per project. `number` is the official Art Polis number.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { number: String(entry.data.number) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const visitedDates = [...entry.data.visitedDates].sort((a, b) => b.localeCompare(a));
---

<Base title={`${entry.data.name} | Kumamoto Art Polis`}>
  <main class="mx-auto max-w-2xl p-8">
    <a href="/" class="text-sm text-rose-600 hover:underline">← 一覧へ戻る</a>

    <h1 class="mt-4 text-2xl font-bold">{entry.data.name}</h1>
    <p class="mt-1 text-sm text-gray-600">
      {entry.data.architects.join("、")} / {entry.data.completedYear}年 / {
        entry.data.municipality
      } / {entry.data.use}
    </p>

    <div class="mt-6 text-gray-800">
      <Content />
    </div>

    <section class="mt-8">
      <h2 class="text-lg font-semibold">訪問記録</h2>
      {
        visitedDates.length > 0 ? (
          // TODO: link each date to its /status/$slug page once visit records exist.
          <ul class="mt-2 space-y-1 text-sm text-gray-700">
            {visitedDates.map((date) => (
              <li>{date}</li>
            ))}
          </ul>
        ) : (
          <p class="mt-2 text-gray-500">まだ訪問記録がありません。</p>
        )
      }
    </section>
  </main>
</Base>

---
import { getCollection } from "astro:content";
import EntryDetail from "../../components/EntryDetail.astro";
import { getVisitsByEntry } from "../../lib/visits.ts";

// Prerender one page per project, keyed by the human-readable slug.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const visits = await getVisitsByEntry();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, visits: visits.get(`/projects/${entry.id}`) ?? [] },
  }));
}

const { entry, visits } = Astro.props;
---

<EntryDetail entry={entry} visits={visits} />

---
import { getCollection, render } from "astro:content";
import ExplorerTable from "../../components/ExplorerTable.astro";
import Base from "../../layouts/Base.astro";
import { toProjectRow } from "../../lib/explorer.ts";
import { getVisitDatesByProject } from "../../lib/projects.ts";

// Prerender one page per project, keyed by the human-readable slug.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const visits = await getVisitDatesByProject();
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, visitedDates: visits.get(entry.data.slug) ?? [] },
  }));
}

const { entry, visitedDates } = Astro.props;
const { Content } = await render(entry);

const row = toProjectRow(entry, visitedDates[0] ?? null);
---

<Base
  title={`Kumamoto Artpolis > ${entry.data.name}`}
  mapFocus={{ lat: entry.data.lat, lng: entry.data.lng }}
>
  <ExplorerTable rows={[row]} />
  {/* relative stacks the text above the persisted fixed map layer (positioned
      elements paint over it in tree order); pointer-events-none + auto children
      let clicks in the gaps still reach the map square behind. */}
  <main class="pointer-events-none relative mx-auto max-w-2xl p-8">
    <a href="/" class="pointer-events-auto text-base text-rose-600 hover:underline">← 一覧へ戻る</a>

    <h1 class="pointer-events-auto mt-4 text-base font-bold">{entry.data.name}</h1>

    <div class="pointer-events-auto mt-6 text-gray-800">
      <Content />
    </div>

    <section class="pointer-events-auto mt-8">
      <h2 class="text-base font-semibold">訪問記録</h2>
      {
        visitedDates.length > 0 ? (
          <ul class="mt-2 space-y-1 text-base">
            {visitedDates.map((date) => (
              <li>
                <a href={`/status/${date}`} class="text-rose-600 hover:underline">
                  {date}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-2 text-gray-500">まだ訪問記録がありません。</p>
        )
      }
    </section>
  </main>
</Base>

---
import { getCollection } from "astro:content";
import EntryDetail from "../../components/EntryDetail.astro";
import { getVisitDatesByEntry } from "../../lib/visits.ts";

// Prerender one page per project, keyed by the human-readable slug.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const visits = await getVisitDatesByEntry();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, visitedDates: visits.get(`/projects/${entry.id}`) ?? [] },
  }));
}

const { entry, visitedDates } = Astro.props;
---

<EntryDetail entry={entry} visitedDates={visitedDates} />

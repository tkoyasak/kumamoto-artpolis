---
import { getCollection, getEntries, render } from "astro:content";
import Base from "../../layouts/Base.astro";

// A day's visit record, keyed by date (YYYY-MM-DD). One page per status entry.
// The day's projects come from the entry's `projects` references; the body
// holds the notes and photos.
export async function getStaticPaths() {
  const status = await getCollection("status");
  return status.map((entry) => ({
    params: { date: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const date = entry.id;
const { Content } = await render(entry);
const projects = (await getEntries(entry.data.projects)).sort(
  (a, b) => a.data.number - b.data.number,
);
---

<Base title={`${date} の訪問記録 | Kumamoto Artpolis`}>
  <main class="mx-auto max-w-2xl p-8">
    <a href="/" class="text-sm text-rose-600 hover:underline">← 一覧へ戻る</a>

    <h1 class="mt-4 text-2xl font-bold">{date} の訪問記録</h1>

    <div class="mt-6 text-gray-800">
      <Content />
    </div>

    {
      projects.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold">この日訪れたプロジェクト</h2>
          <ul class="mt-2 space-y-1 text-sm">
            {projects.map((project) => (
              <li>
                <a
                  href={`/projects/${project.data.slug}`}
                  class="text-rose-600 hover:underline"
                >
                  {project.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

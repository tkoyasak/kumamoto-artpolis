---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getVisitedEntries } from "../../lib/visits.ts";

// A day's visit record, keyed by date (YYYY-MM-DD). One page per status entry.
// The day's visited entries come from the entry's `projects` and `kap92`
// references; the body holds the notes and photos.
export async function getStaticPaths() {
  const status = await getCollection("status");
  return status.map((entry) => ({
    params: { date: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const date = entry.id;
const { Content } = await render(entry);
const visitedEntries = await getVisitedEntries(entry);
---

<Base title={`${date} の訪問記録 | Kumamoto Artpolis`}>
  <main class="max-w-2xl p-4 sm:p-8">
    <h1 class="text-base font-bold">{date} の訪問記録</h1>

    <div class="mt-6 text-gray-800">
      <Content />
    </div>

    {
      visitedEntries.length > 0 && (
        <section class="mt-8">
          <h2 class="text-base font-semibold">この日の訪問先</h2>
          <ul class="mt-2 space-y-1 text-base">
            {visitedEntries.map((entry) => (
              <li>
                <a
                  href={`/${entry.collection}/${entry.id}`}
                  class="text-rose-600 hover:underline"
                >
                  {entry.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

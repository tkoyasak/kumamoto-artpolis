---
import { getCollection, getEntries, render } from "astro:content";
import Base from "../../layouts/Base.astro";

// A day's visit record, keyed by date (YYYY-MM-DD). One page per status entry.
// The day's visited entries come from the entry's `projects` and `kap92`
// references; the body holds the notes and photos.
export async function getStaticPaths() {
  const status = await getCollection("status");
  return status.map((entry) => ({
    params: { date: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const date = entry.id;
const { Content } = await render(entry);
const visited = [
  ...(await getEntries(entry.data.projects)),
  ...(await getEntries(entry.data.kap92)),
].sort((a, b) => {
  if (a.collection !== b.collection) return a.collection === "projects" ? -1 : 1;
  return a.data.number - b.data.number;
});
---

<Base title={`${date} の訪問記録 | Kumamoto Artpolis`}>
  <main class="mx-auto max-w-2xl p-8">
    <a href="/" class="text-base text-rose-600 hover:underline">← 一覧へ戻る</a>

    <h1 class="mt-4 text-base font-bold">{date} の訪問記録</h1>

    <div class="mt-6 text-gray-800">
      <Content />
    </div>

    {
      visited.length > 0 && (
        <section class="mt-8">
          <h2 class="text-base font-semibold">この日の訪問先</h2>
          <ul class="mt-2 space-y-1 text-base">
            {visited.map((item) => (
              <li>
                <a
                  href={`/${item.collection}/${item.id}`}
                  class="text-rose-600 hover:underline"
                >
                  {item.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

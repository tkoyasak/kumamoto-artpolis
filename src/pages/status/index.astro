---
import StatusTable from "../../components/StatusTable.astro";
import Base from "../../layouts/Base.astro";
import { getStatusRows } from "../../lib/status.ts";

// Timeline of all visit records, newest first (one row per visit).
const rows = await getStatusRows();
---

<Base title="Status">
  <Fragment slot="status">
    <StatusTable rows={rows} />
  </Fragment>
</Base>
